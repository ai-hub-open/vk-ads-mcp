# === Источник токена VK Ads — выберите ОДИН вариант ===

# --- Вариант A: готовый access_token (самый простой) ---
# ads.vk.com → Настройки профиля → Получить токен / API
VK_ADS_ACCESS_TOKEN=

# --- Вариант B: OAuth 2.0 Client Credentials (сервер сам получает и обновляет токен) ---
# client_id + client_secret выдаются после одобрения приложения на target.vk.ru
# VK_ADS_CLIENT_ID=
# VK_ADS_CLIENT_SECRET=

# --- Вариант C: агентство от имени клиента (дополняет вариант B) ---
# Переключает на grant_type=agency_client_credentials
# VK_ADS_AGENCY_CLIENT_NAME=<username клиента>

# --- Вариант D: токен VK Ads через Click.ru (свои VK-креды не нужны) ---
# CLICK_RU_TOKEN — API Token из профиля https://click.ru/userinfo.html
# CLICK_RU_ACCOUNT_ID — ID рекламного аккаунта VK Рекламы в Click.ru
#   (GET /accounts в https://api.click.ru/V0/docs/ → поле id)
# CLICK_RU_TOKEN=
# CLICK_RU_ACCOUNT_ID=
# CLICK_RU_USER_ID=          # X-Auth-UserId — только при работе из мастер-аккаунта
# CLICK_RU_BASE_URL=https://api.click.ru/V0  # опционально

# --- Опционально ---
# VK_ADS_BASE_URL=https://ads.vk.com
# VK_ADS_TIMEOUT=30
# Язык названий в справочниках (регионы, интересы, отрасли)
# VK_ADS_LANG=ru

# --- Загрузка креативов: доступ к файлам и сети ---
# По умолчанию для stdio разрешено (файлы и сеть — ваши собственные),
# для HTTP-режима выключено: иначе вызывающий сможет прочитать файлы сервера
# или сходить на его внутренние адреса. Меняйте осознанно.
# VK_ADS_ALLOW_LOCAL_FILES=false      # чтение креативов с диска сервера
# VK_ADS_ALLOW_PRIVATE_NETWORK=false  # загрузка по URL во внутренней сети

# --- Транспорт ---
# stdio (по умолч.) или http
# MCP_TRANSPORT=http
# MCP_PORT=3000
# MCP_HOST=0.0.0.0
# MCP_AUTH_TOKEN=секрет-для-bearer-авторизации
# MCP_ALLOWED_ORIGIN=https://example.com

# Данные доступа прямо в адресе — для клиентов, которые не умеют задавать
# заголовки (Claude Desktop). Формы адреса:
#   https://ваш-домен/t/<токен VK Ads>                 — готовый токен (живёт 24 ч)
#   https://ваш-домен/o/<client_id>/<client_secret>    — сервер обновляет токен сам
#   https://ваш-домен/c/<токен click.ru>/<id аккаунта> — сервер обновляет токен сам
# Данные доступа попадают в журналы прокси-сервера — включайте осознанно.
# MCP_ALLOW_URL_TOKEN=true
