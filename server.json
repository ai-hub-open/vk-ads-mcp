{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ai-hub-open/vk-ads-mcp",
  "description": "MCP server for VK Ads API: campaigns, audiences, budgets, stats. Click.ru, token or OAuth.",
  "status": "active",
  "repository": {
    "url": "https://github.com/ai-hub-open/vk-ads-mcp",
    "source": "github"
  },
  "version": "0.4.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@ai-hub-open/vk-ads-mcp",
      "version": "0.4.0",
      "runtimeHint": "bunx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CLICK_RU_TOKEN",
          "description": "Click.ru API token (primary mode)",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "CLICK_RU_ACCOUNT_ID",
          "description": "VK Ads account id in Click.ru",
          "isRequired": false
        },
        {
          "name": "VK_ADS_ACCESS_TOKEN",
          "description": "Static VK Ads token (alternative mode)",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "VK_ADS_CLIENT_ID",
          "description": "OAuth app client id (target.vk.ru)",
          "isRequired": false
        },
        {
          "name": "VK_ADS_CLIENT_SECRET",
          "description": "OAuth app client secret",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}